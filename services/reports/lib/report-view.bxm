<!-- report-view.bxm - HTML security report template.
     Expects an enriched `report` struct in scope (see ReportService.enrich()).
     NOTE: in .bxm files every literal hash is written twice (two hashes) so the
     parser does not treat it as an interpolation; dynamic values use a single hash. -->
<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<bx:output><title>Reporte Red-Team ATLAS - #encodeForHTML( report.target )#</title></bx:output>
<style>
  :root { color-scheme: light dark;
    --bg:##f6f7f9; --card:##fff; --ink:##1a1d22; --mut:##5b6572; --line:##e3e6ea; }
  @media (prefers-color-scheme: dark) { :root {
    --bg:##0f1216; --card:##171b21; --ink:##e8ebef; --mut:##9aa6b3; --line:##262c34; } }
  * { box-sizing:border-box; }
  body { margin:0; font:15px/1.55 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg); color:var(--ink); padding:24px 16px; }
  .wrap { max-width:1000px; margin:0 auto; }
  h1 { font-size:22px; margin:0 0 2px; }
  .sub { color:var(--mut); margin:0 0 20px; font-size:13px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:12px;
    padding:18px 20px; margin-bottom:16px; }
  .grid { display:grid; grid-template-columns:200px 1fr; gap:20px; align-items:center; }
  @media (max-width:640px) { .grid { grid-template-columns:1fr; } }
  .gauge { text-align:center; }
  .gauge .num { font-size:52px; font-weight:800; line-height:1; }
  .gauge .band { display:inline-block; margin-top:6px; padding:3px 10px; border-radius:20px;
    color:##fff; font-size:12px; font-weight:700; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; }
  .chip { padding:5px 10px; border-radius:8px; border:1px solid; font-size:13px; }
  .chip b { font-size:15px; }
  .chip-ok { color:##2f7d4f; border-color:##2f7d4f; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th,td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--mut); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.04em; }
  code { background:rgba(128,128,128,.14); padding:1px 5px; border-radius:4px; font-size:12px; }
  .pill { color:##fff; padding:2px 9px; border-radius:20px; font-size:11px; font-weight:700; text-transform:uppercase; }
  .bar { background:rgba(128,128,128,.18); border-radius:5px; height:9px; overflow:hidden; }
  .bar i { display:block; height:100%; }
  .ev { color:var(--mut); font-family:ui-monospace,monospace; }
  .ok { text-align:center; color:##2f7d4f; padding:18px; }
  h2 { font-size:14px; text-transform:uppercase; letter-spacing:.05em; color:var(--mut); margin:0 0 10px; }
  ul { margin:4px 0; padding-left:18px; }
  .foot { color:var(--mut); font-size:12px; text-align:center; margin-top:8px; }
</style></head>
<body><div class="wrap">

<bx:output>
  <h1>Reporte de Seguridad - AI Red-Team</h1>
  <p class="sub">Objetivo: <b>#encodeForHTML( report.target )#</b> ·
     MITRE ATLAS #encodeForHTML( report.catalog_version )# ·
     #encodeForHTML( report.started_at )# · #report.rounds# ronda(s)</p>

  <div class="card"><div class="grid">
    <div class="gauge">
      <div class="num" style="color:#report.band.color#">#report.summary.risk_score#</div>
      <div class="band" style="background:#report.band.color#">#report.band.label# risk</div>
    </div>
    <div>
      <p style="margin:0 0 10px"><b>#report.summary.vulnerabilities#</b> de
         <b>#report.summary.probes_run#</b> sondas penetraron el objetivo.</p>
      <div class="chips">
        <bx:if report.severityRows.len()>
          <bx:loop array="#report.severityRows#" item="sv">
            <span class="chip" style="color:#sv.color#;border-color:#sv.color#"><b>#sv.count#</b> #sv.sev#</span>
          </bx:loop>
        <bx:else>
          <span class="chip chip-ok"><b>0</b> hallazgos</span>
        </bx:if>
      </div>
    </div>
  </div></div>

  <div class="card">
    <h2>Resultados por area de prueba</h2>
    <table><thead><tr><th>Categoria</th><th>Penetradas</th><th></th></tr></thead>
    <tbody>
      <bx:loop array="#report.categoryRows#" item="cat">
        <tr>
          <td>#encodeForHTML( cat.category )#</td>
          <td>#cat.vulnerable#/#cat.total#</td>
          <td><div class="bar"><i style="width:#cat.pct#%;background:#report.band.color#"></i></div></td>
        </tr>
      </bx:loop>
    </tbody></table>
  </div>

  <div class="card">
    <h2>Cobertura de tecnicas MITRE ATLAS</h2>
    <table><thead><tr><th>Tecnica</th><th>Nombre</th><th>Penetr./Probadas</th></tr></thead>
    <tbody>
      <bx:loop array="#report.atlasRows#" item="a">
        <tr>
          <td><code>#encodeForHTML( a.tid )#</code></td>
          <td>#encodeForHTML( a.name )#</td>
          <td>#a.vulnerable#/#a.tested#</td>
        </tr>
      </bx:loop>
    </tbody></table>
  </div>

  <div class="card">
    <h2>Hallazgos y remediacion</h2>
    <table><thead><tr><th>Sev</th><th>Sonda</th><th>ATLAS</th><th>Hallazgo</th><th>Mitigaciones sugeridas</th></tr></thead>
    <tbody>
      <bx:if report.vulnFindings.len()>
        <bx:loop array="#report.vulnFindings#" item="f">
          <tr>
            <td><span class="pill" style="background:#f.sevColor#">#f.severity#</span></td>
            <td><b>#encodeForHTML( f.probe_name )#</b><br><small>#encodeForHTML( f.probe_id )# · #encodeForHTML( f.channel )#</small></td>
            <td><code>#encodeForHTML( f.atlas_technique )#</code> #encodeForHTML( f.atlas_technique_name )#<br>
                <small>Tacticas: #encodeForHTML( f.tactics )#</small></td>
            <td>#encodeForHTML( f.rationale )#<br><small class="ev">#encodeForHTML( f.evidence )#</small></td>
            <td>
              <bx:if f.mitigations.len()>
                <ul><bx:loop array="#f.mitigations#" item="m"><li>#encodeForHTML( m )#</li></bx:loop></ul>
              <bx:else>
                <em>Ver mitigaciones ATLAS</em>
              </bx:if>
            </td>
          </tr>
        </bx:loop>
      <bx:else>
        <tr><td colspan="5" class="ok">Sin vulnerabilidades detectadas - el objetivo defendio todas las sondas.</td></tr>
      </bx:if>
    </tbody></table>
  </div>

  <p class="foot">Generado por atlas-redteam (BoxLang) · evaluacion educativa de seguridad de IA ·
     tecnicas y mitigaciones MITRE ATLAS (Apache-2.0)</p>
</bx:output>

</div></body></html>
