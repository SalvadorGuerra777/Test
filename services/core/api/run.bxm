<bx:script>
bx:header name="Content-Type" value="application/json; charset=utf-8";
// CORS: this endpoint is called directly from the browser (the frontend
// artifact runs on claude.ai's origin), so every response — including the
// preflight — needs these. Verified against a real browser-style OPTIONS
// preflight, not assumed.
bx:header name="Access-Control-Allow-Origin" value="*";
bx:header name="Access-Control-Allow-Methods" value="POST, OPTIONS";
bx:header name="Access-Control-Allow-Headers" value="Content-Type";

requestData = getHTTPRequestData();

if ( compareNoCase( requestData.method, "OPTIONS" ) == 0 ) {
    bx:header statusCode=204;

} else if ( compareNoCase( requestData.method, "POST" ) != 0 ) {
    bx:header statusCode=405;
    writeOutput( jsonSerialize( {
        "ok": false,
        "error": "Use POST with a JSON body: { targetType, targetDescription }"
    } ) );

} else {

    payload = {};
    parseFailed = false;
    try {
        payload = jsonDeserialize( requestData.content );
    } catch ( any e ) {
        parseFailed = true;
    }

    targetType        = payload.targetType ?: "";
    targetDescription = payload.targetDescription ?: "";

    if ( parseFailed || !len( targetType ) ) {
        bx:header statusCode=400;
        writeOutput( jsonSerialize( {
            "ok": false,
            "error": "Invalid or missing body. Required: { targetType: string, targetDescription?: string }"
        } ) );

    } else {

        planner = new models.Planner();
        result  = planner.createPlan( targetType, targetDescription );

        bx:header statusCode=200;
        writeOutput( jsonSerialize( {
            "ok"        : true,
            "targetType": result.targetType,
            "plan"      : result.plan
        } ) );

    }
}
</bx:script>
