<bx:script>
// Renders an archived report as HTML by id - the browser just navigates a
// new tab here (plain GET, same as opening a link). The JSON never leaves
// the server: core reads the archive and POSTs it to the reports service
// over the internal Docker network. This replaced the browser POSTing the
// report JSON cross-origin to reports/report.bxm, which intermittently
// arrived with an empty body (400) in some real browsers (Brave on Windows)
// and never reproduced anywhere else - a GET navigation has no body, no
// preflight and no popup-blocker interaction to go wrong.
reportId = url.id ?: "";

function errorPage( required numeric status, required string message ) {
    bx:header statusCode=arguments.status;
    bx:header name="Content-Type" value="text/html; charset=utf-8";
    writeOutput( "<!doctype html><meta charset='utf-8'><title>Report unavailable</title>"
        & "<body style='font:15px/24px Inter,system-ui,sans-serif;background:##fbfafa;color:##1b1417;padding:48px'>"
        & "<p style='font-size:12px;font-weight:600;letter-spacing:.06em;color:##c8102e;margin:0'>REXOR</p>"
        & "<h1 style='font:600 24px/32px ""Space Grotesk"",system-ui,sans-serif;margin:8px 0'>Report unavailable</h1>"
        & "<p style='color:##5e5459'>" & encodeForHTML( arguments.message ) & "</p></body>" );
}

if ( !reFind( "^[A-Za-z0-9-]{1,64}$", reportId ) ) {
    errorPage( 400, "Missing or invalid report id." );
} else {
    path = "/app/data/reports/" & reportId & ".json";
    if ( !fileExists( path ) ) {
        errorPage( 404, "No report with that id. Reports live on the core container's disk and don't survive a rebuild." );
    } else {
        // Reports archived before the envelope matched the harness's
        // Finding contract lack `round`/`response_excerpt`, which the
        // reports service reads on every vulnerable finding (HTTP 500
        // otherwise) - backfill them so old reports still open.
        report = jsonDeserialize( fileRead( path ) );
        for ( f in report.findings ?: [] ) {
            if ( !structKeyExists( f, "round" ) ) f[ "round" ] = 0;
            // Old archives never stored the target's reply; `evidence` is not
            // a stand-in (reports masks every evidence value as a leaked
            // secret), so leave the evidence block out rather than fake it.
            if ( !structKeyExists( f, "response_excerpt" ) ) f[ "response_excerpt" ] = "";
            if ( !structKeyExists( f, "atlas_tactics" ) ) f[ "atlas_tactics" ] = [];
        }

        reportsUrl = getSystemSetting( "REPORTS_INTERNAL_URL", "http://reports:8080/report.bxm" );
        bx:http url="#reportsUrl#" method="POST" timeout="60" charset="utf-8" result="res" {
            bx:httpparam type="header" name="Content-Type" value="application/json; charset=utf-8";
            bx:httpparam type="body" value="#jsonSerialize( report )#";
        }
        if ( val( res.statusCode ) != 200 || len( res.errorDetail ?: "" ) ) {
            errorPage( 502, "The reports service could not render this report (" & ( len( res.errorDetail ?: "" ) ? res.errorDetail : "HTTP " & res.statusCode ) & ")." );
        } else {
            bx:header name="Content-Type" value="text/html; charset=utf-8";
            writeOutput( res.fileContent );
        }
    }
}
</bx:script>
