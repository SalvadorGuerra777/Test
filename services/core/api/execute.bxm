<bx:script>
bx:header name="Content-Type" value="application/json; charset=utf-8";
bx:header name="Access-Control-Allow-Origin" value="*";
bx:header name="Access-Control-Allow-Methods" value="POST, OPTIONS";
bx:header name="Access-Control-Allow-Headers" value="Content-Type";

// Recursively replaces every string value equal to `placeholder` inside a
// JSON-shaped struct/array with `value`, then the caller re-serializes with
// jsonSerialize — this is how a user-defined bodyTemplate (e.g. an n8n
// webhook's own JSON shape) gets the real probe payload injected, with
// quotes/newlines in the payload escaped correctly instead of hand-rolled
// string interpolation into a template string.
function substitutePlaceholder( required any node, required string placeholder, required string value ) {
    if ( isStruct( arguments.node ) ) {
        var result = {};
        for ( var key in arguments.node ) {
            result[ key ] = substitutePlaceholder( arguments.node[ key ], arguments.placeholder, arguments.value );
        }
        return result;
    } else if ( isArray( arguments.node ) ) {
        return arguments.node.map( ( item ) => substitutePlaceholder( item, arguments.placeholder, arguments.value ) );
    } else if ( isSimpleValue( arguments.node ) && arguments.node == arguments.placeholder ) {
        return arguments.value;
    }
    return arguments.node;
}

// Dot-path walker into a parsed JSON response, e.g. "0.output" for an n8n
// webhook that replies with [{"output": "..."}]. Array indices are 0-based
// (JS/JSON convention) even though BoxLang arrays are 1-based internally.
function resolvePath( required any data, required string path ) {
    if ( !len( trim( arguments.path ) ) ) return arguments.data;
    var current = arguments.data;
    for ( var seg in listToArray( arguments.path, "." ) ) {
        if ( isArray( current ) ) {
            current = current[ val( seg ) + 1 ];
        } else if ( isStruct( current ) ) {
            current = current[ seg ];
        } else {
            return "";
        }
    }
    return current;
}

requestData = getHTTPRequestData();

if ( compareNoCase( requestData.method, "OPTIONS" ) == 0 ) {
    bx:header statusCode=204;

} else if ( compareNoCase( requestData.method, "POST" ) != 0 ) {
    bx:header statusCode=405;
    writeOutput( jsonSerialize( { "ok": false, "error": "Use POST with a JSON body: { probeIds, targetAdapter }" } ) );

} else {

    body = {};
    parseFailed = false;
    try {
        body = jsonDeserialize( requestData.content );
    } catch ( any e ) {
        parseFailed = true;
    }

    probeIds   = ( !parseFailed && isArray( body.probeIds ?: "" ) ) ? body.probeIds : [];
    adapter    = body.targetAdapter ?: {};
    targetName = len( trim( body.target ?: "" ) ) ? body.target : ( adapter.url ?: "target" );

    if ( parseFailed || probeIds.isEmpty() || !structKeyExists( adapter, "url" ) || !structKeyExists( adapter, "bodyTemplate" ) ) {
        bx:header statusCode=400;
        writeOutput( jsonSerialize( {
            "ok": false,
            "error": "Invalid body. Required: { probeIds: [string, ...], targetAdapter: { url, bodyTemplate, method?, headers?, responsePath? } }. bodyTemplate must contain the string {{PROMPT}} where the attack payload goes."
        } ) );

    } else {

        atlasMcpUrl = getSystemSetting( "ATLAS_MCP_URL", "http://atlas-redteam:8765/mcp" );
        mcp = MCP( atlasMcpUrl );

        method       = adapter.method ?: "POST";
        headers      = adapter.headers ?: {};
        responsePath = adapter.responsePath ?: "";

        findings = [];

        for ( probeId in probeIds ) {

            probeResp = mcp.send( "get_probe", { "probe_id": probeId } );
            if ( !probeResp.isSuccess() ) {
                findings.append( { "probeId": probeId, "error": "get_probe failed: " & probeResp.getError() } );
                continue;
            }
            probeData  = probeResp.getData().structuredContent;
            attackText = probeData.payload ?: "";

            requestBody = substitutePlaceholder( adapter.bodyTemplate, "{{PROMPT}}", attackText );

            bx:http url="#adapter.url#" method="#method#" timeout="30" result="targetRes" {
                for ( headerName in headers ) {
                    bx:httpparam type="header" name="#headerName#" value="#headers[ headerName ]#";
                }
                bx:httpparam type="header" name="Content-Type" value="application/json";
                bx:httpparam type="body" value="#jsonSerialize( requestBody )#";
            }

            if ( val( targetRes.statusCode ) >= 400 || len( targetRes.errorDetail ?: "" ) ) {
                findings.append( {
                    "probeId": probeId,
                    "atlasTechnique": probeData.atlas_technique ?: "",
                    "error": "target request failed: " & ( len( targetRes.errorDetail ?: "" ) ? targetRes.errorDetail : "HTTP " & targetRes.statusCode )
                } );
                continue;
            }

            targetText = "";
            if ( len( trim( responsePath ) ) ) {
                try {
                    targetText = toString( resolvePath( jsonDeserialize( targetRes.fileContent ), responsePath ) );
                } catch ( any e ) {
                    targetText = targetRes.fileContent;
                }
            } else {
                targetText = targetRes.fileContent;
            }

            judgeResp = mcp.send( "judge_response", { "probe_id": probeId, "response": targetText } );
            if ( judgeResp.isSuccess() ) {
                finding = judgeResp.getData().structuredContent;
                finding[ "targetResponse" ] = targetText;
                finding[ "probe_name" ]     = probeData.name ?: "";
                finding[ "category" ]       = probeData.category ?: "";
                finding[ "channel" ]        = probeData.channel ?: "";
                findings.append( finding );
            } else {
                findings.append( { "probeId": probeId, "error": "judge_response failed: " & judgeResp.getError(), "targetResponse": targetText } );
            }
        }

        // ------------------------------------------------------------------
        // Build the report envelope the `reports` microservice expects
        // (same shape/formula as atlas_redteam.harness.EvalReport.to_dict(),
        // so one report template covers both the Python harness output and
        // this live-execution path). Only successful findings go in — a
        // {probeId, error} entry isn't a scored finding.
        // ------------------------------------------------------------------
        SEV_WEIGHT = { "info": 0, "low": 1, "medium": 3, "high": 7, "critical": 12 };

        reportFindings = findings.filter( ( f ) => !structKeyExists( f, "error" ) );

        bySeverity = {};
        byCategory = {};
        atlasCoverage = {};
        maxWeight = 0;
        gotWeight = 0;

        for ( f in reportFindings ) {
            sevKey = f.severity ?: "info";
            w = SEV_WEIGHT[ sevKey ] ?: 0;
            maxWeight += w;
            if ( f.vulnerable ) {
                gotWeight += w;
                bySeverity[ sevKey ] = ( bySeverity[ sevKey ] ?: 0 ) + 1;
            }

            cat = len( f.category ?: "" ) ? f.category : "uncategorized";
            if ( !structKeyExists( byCategory, cat ) ) byCategory[ cat ] = { "total": 0, "vulnerable": 0 };
            byCategory[ cat ].total++;
            if ( f.vulnerable ) byCategory[ cat ].vulnerable++;

            tech = f.atlas_technique ?: "";
            if ( len( tech ) ) {
                if ( !structKeyExists( atlasCoverage, tech ) ) {
                    atlasCoverage[ tech ] = { "name": f.atlas_technique_name ?: tech, "tested": 0, "vulnerable": 0 };
                }
                atlasCoverage[ tech ].tested++;
                if ( f.vulnerable ) atlasCoverage[ tech ].vulnerable++;
            }
        }

        riskScore = maxWeight > 0 ? round( 100 * gotWeight / maxWeight ) : 0;

        catalogVersion = "";
        statsResp = mcp.send( "atlas_stats", {} );
        if ( statsResp.isSuccess() ) {
            catalogVersion = statsResp.getData().structuredContent.version ?: "";
        }

        reportEnvelope = {
            "target"         : targetName,
            "catalog_version": catalogVersion,
            "started_at"     : dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" ),
            "rounds"         : 1,
            "summary": {
                "probes_run"     : reportFindings.len(),
                "vulnerabilities": reportFindings.filter( ( f ) => f.vulnerable ).len(),
                "risk_score"     : riskScore,
                "by_severity"    : bySeverity,
                "by_category"    : byCategory
            },
            "atlas_coverage": atlasCoverage,
            "findings": reportFindings.map( ( f ) => ( {
                "probe_id"            : f.probe_id,
                "probe_name"          : f.probe_name,
                "category"            : f.category,
                "channel"             : f.channel,
                "severity"            : f.severity,
                "atlas_technique"     : f.atlas_technique,
                "atlas_technique_name": f.atlas_technique_name,
                "vulnerable"          : f.vulnerable,
                "rationale"           : f.rationale,
                "evidence"            : f.evidence ?: ""
            } ) )
        };

        bx:header statusCode=200;
        writeOutput( jsonSerialize( { "ok": true, "findings": findings, "report": reportEnvelope } ) );
    }
}
</bx:script>
