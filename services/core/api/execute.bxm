<bx:script>
bx:header name="Content-Type" value="application/json; charset=utf-8";
bx:header name="Access-Control-Allow-Origin" value="*";
bx:header name="Access-Control-Allow-Methods" value="POST, OPTIONS";
bx:header name="Access-Control-Allow-Headers" value="Content-Type";

requestData = getHTTPRequestData();

if ( compareNoCase( requestData.method, "OPTIONS" ) == 0 ) {
    bx:header statusCode=204;

} else if ( compareNoCase( requestData.method, "POST" ) != 0 ) {
    bx:header statusCode=405;
    writeOutput( jsonSerialize( { "ok": false, "error": "Use POST with a JSON body: { probeIds, targetAdapter }" } ) );

} else {

    body = {};
    parseFailed = false;
    try {
        body = jsonDeserialize( requestData.content );
    } catch ( any e ) {
        parseFailed = true;
    }

    probeIds   = ( !parseFailed && isArray( body.probeIds ?: "" ) ) ? body.probeIds : [];
    adapter    = body.targetAdapter ?: {};
    targetName = len( trim( body.target ?: "" ) ) ? body.target : ( adapter.url ?: "target" );
    secrets    = ( !parseFailed && isArray( body.secrets ?: "" ) ) ? body.secrets : [];

    if ( parseFailed || probeIds.isEmpty() || !structKeyExists( adapter, "url" ) || !structKeyExists( adapter, "bodyTemplate" ) ) {
        bx:header statusCode=400;
        writeOutput( jsonSerialize( {
            "ok": false,
            "error": "Invalid body. Required: { probeIds: [string, ...], targetAdapter: { url, bodyTemplate, method?, headers?, responsePath? } }. bodyTemplate must contain the string {{PROMPT}} where the attack payload goes."
        } ) );

    } else {

        executor = new models.Executor();
        result   = executor.runProbes( probeIds, adapter, targetName, "", secrets );

        bx:header statusCode=200;
        writeOutput( jsonSerialize( { "ok": true, "findings": result.findings, "report": result.report } ) );
    }
}
</bx:script>
